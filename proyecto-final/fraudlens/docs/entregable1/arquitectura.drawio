xGeometry x="40" y="226" width="276" height="116" as="geometry"/></mxCell><mxCell id="prod_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;" vertex="1" parent="1"><mxGeometry x="48" y="235" width="40" height="40" as="geometry"/></mxCell><mxCell id="prod_t" value="&lt;b style=&quot;font-size:13.5px;color:#0F6E56&quot;&gt;Productor de transacciones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.8px;color:#232F3E&quot;&gt;Python + Faker (simula la app y la API)&lt;br&gt;Eventos JSON · ~1.000 ev/s, pico 5.000&lt;br&gt;Escenarios de fraude, duplicados&lt;br&gt;y JSON malformado (semilla fija)&lt;/span&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="94" y="229" width="218" height="110" as="geometry"/></mxCell><mxCell id="pg" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="40" y="534" width="276" height="96" as="geometry"/></mxCell><mxCell id="pg_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;" vertex="1" parent="1"><mxGeometry x="48" y="543" width="40" height="40" as="geometry"/></mxCell><mxCell id="pg_t" value="&lt;b style=&quot;font-size:13.5px;color:#0F6E56&quot;&gt;PostgreSQL 16 (operacional)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.8px;color:#232F3E&quot;&gt;Clientes y comercios (relacional)&lt;br&gt;Contenedor que simula la BD de la app&lt;br&gt;Extracción batch diaria&lt;/span&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="94" y="537" width="218" height="90" as="geometry"/></mxCell><mxCell id="csv" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="40" y="724" width="276" height="96" as="geometry"/></mxCell><mxCell id="csv_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.bucket_with_objects;" vertex="1" parent="1"><mxGeometry x="48" y="733" width="40" height="40" as="geometry"/></mxCell><mxCell id="csv_t" value="&lt;b style=&quot;font-size:13.5px;color:#0F6E56&quot;&gt;Listas de riesgo (CSV)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.8px;color:#232F3E&quot;&gt;Comercios y dispositivos en lista negra&lt;br&gt;Se suben a s3://…/landing/&lt;br&gt;Versión nueva periódica&lt;/span&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="94" y="727" width="218" height="90" as="geometry"/></mxCell><mxCell id="kafka" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FFFFFF;strokeColor=#185FA5;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="345" y="226" width="276" height="232" as="geometry"/></mxCell><mxCell id="kafka_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;" vertex="1" parent="1"><mxGeometry x="353" y="235" width="40" height="40" as="geometry"/></mxCell><mxCell id="kafka_t" value="&lt;b style=&quot;font-size:13.5px;color:#185FA5&quot;&gt;Apache Kafka · 3 brokers KRaft&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.8px;color:#232F3E&quot;&gt;cp-kafka 7.6.0 (Lab 2a)&lt;br&gt;Topic transacciones · 12 particiones&lt;br&gt;Clave id_cliente · replicación 3&lt;br&gt;acks=all · min.insync.replicas=2 (CP)&lt;br&gt;Productor idempotente&lt;br&gt;Retención 7 días (replay)&lt;br&gt;Garantía at-least-once&lt;br&gt;Topic transacciones_dlq (inválidos)&lt;/span&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="399" y="229" width="218" height="226" as="geometry"/></mxCell><mxCell id="extract" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FFFFFF;strokeColor=#185FA5;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="345" y="534" width="276" height="136" as="geometry"/></mxCell><mxCell id="extract_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;" vertex="1" parent="1"><mxGeometry x="353" y="543" width="40" height="40" as="geometry"/></mxCell><mxCell id="extract_t" value="&lt;b style=&quot;font-size:13.5px;color:#185FA5&quot;&gt;Airflow + PySpark (extracción)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.8px;color:#232F3E&quot;&gt;JDBC PostgreSQL → Bronze (diario)&lt;br&gt;S3KeySensor: CSV nuevo → Bronze&lt;br&gt;MERGE idempotente (at-least-once)&lt;br&gt;3 reintentos · espera exponencial&lt;/span&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="399" y="537" width="218" height="130" as="geometry"/></mxCell><mxCell id="stream" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FFFFFF;strokeColor=#854F0B;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="650" y="226" width="276" height="232" as="geometry"/></mxCell><mxCell id="stream_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;" vertex="1" parent="1"><mxGeometry x="658" y="235" width="40" height="40" as="geometry"/></mxCell><mxCell id="stream_t" value="&lt;b style=&quot;font-size:13.5px;color:#854F0B&quot;&gt;Spark Structured Streaming&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.8px;color:#232F3E&quot;&gt;Spark 3.5.1 + Delta 3.1.0 · trigger 5 s&lt;br&gt;JSON inválido → DLQ · esquema&lt;br&gt;Dedup id_transaccion (watermark 10 min)&lt;br&gt;R1 · P1: ventana 5 min / 1 min (update)&lt;br&gt;R2 · P2: dispositivo nuevo y monto&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;gt; 3× promedio de 30 días&lt;br&gt;R3 · P3: lista de riesgo (join)&lt;br&gt;Checkpoint en S3 · restart automático&lt;/span&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="704" y="229" width="218" height="226" as="geometry"/></mxCell><mxCell id="batch" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FFFFFF;strokeColor=#854F0B;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="650" y="534" width="276" height="136" as="geometry"/></mxCell><mxCell id="batch_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;" vertex="1" parent="1"><mxGeometry x="658" y="543" width="40" height="40" as="geometry"/></mxCell><mxCell id="batch_t" value="&lt;b style=&quot;font-size:13.5px;color:#854F0B&quot;&gt;Spark batch dentro de Airflow&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.8px;color:#232F3E&quot;&gt;Patrón del Lab 4a · cada 10 min&lt;br&gt;Silver → Gold: SCD2 + hechos (MERGE)&lt;br&gt;Métricas P4–P6 · OPTIMIZE ZORDER&lt;br&gt;Reproceso por rule_version (Gold)&lt;/span&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="704" y="537" width="218" height="130" as="geometry"/></mxCell><mxCell id="bronze" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FFFFFF;strokeColor=#534AB7;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="985" y="226" width="290" height="84" as="geometry"/></mxCell><mxCell id="bronze_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.bucket;" vertex="1" parent="1"><mxGeometry x="993" y="235" width="34" height="34" as="geometry"/></mxCell><mxCell id="bronze_t" value="&lt;b style=&quot;font-size:13.5px;color:#534AB7&quot;&gt;Bronze · bronze/&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.8px;color:#232F3E&quot;&gt;Crudo, append-only · topic, partición,&lt;br&gt;offset, ingest_ts · catálogos y listas&lt;/span&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1033" y="229" width="238" height="78" as="geometry"/></mxCell><mxCell id="silver" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FFFFFF;strokeColor=#534AB7;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="985" y="330" width="290" height="100" as="geometry"/></mxCell><mxCell id="silver_i" value="" style="sketch=0;outlineConnect=